#!/bin/sh

APPDIR=$(dirname "$(readlink -f "$0")")
APPIMAGE_LIBRARY_PATH="$APPDIR${CMAKE_INSTALL_PREFIX}/lib:$APPDIR${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}"

if [ -n "$LD_LIBRARY_PATH" ] ; then
    APPIMAGE_LIBRARY_PATH="$APPIMAGE_LIBRARY_PATH:$LD_LIBRARY_PATH"
fi

export LD_LIBRARY_PATH="$APPIMAGE_LIBRARY_PATH"

exec "$APPDIR${CMAKE_INSTALL_PREFIX}/${PROJECT_BINARY_INSTALLATION_DIR}/${APPIMAGE_BINARY_NAME}" "$@"
