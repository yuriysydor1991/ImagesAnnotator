#!/bin/sh

APPDIR=$(dirname "$(readlink -f "$0")")
APPIMAGE_LIBRARY_PATH="$APPDIR${APPIMAGE_APPDIR_PREFIX}/lib:$APPDIR${APPIMAGE_APPDIR_PREFIX}/${CMAKE_INSTALL_LIBDIR}"

if [ -n "$LD_LIBRARY_PATH" ] ; then
    APPIMAGE_LIBRARY_PATH="$APPIMAGE_LIBRARY_PATH:$LD_LIBRARY_PATH"
fi

export LD_LIBRARY_PATH="$APPIMAGE_LIBRARY_PATH"

APPIMAGE_BINARY_DIR="$APPDIR${APPIMAGE_APPDIR_PREFIX}/${PROJECT_BINARY_INSTALLATION_DIR}"

# The package carries every binary the project builds and starts the one it is
# started under the name of - the name of a symbolic link to the package, e.g.
# an ImagesAnnotatorConverter one - which the AppImage runtime hands over as the
# ARGV0 (an extracted package started through a link to its AppRun names it in
# the $0 instead). Any other name starts the ${APPIMAGE_BINARY_NAME}.
APPIMAGE_ARGV0=$ARGV0

if [ -z "$APPIMAGE_ARGV0" ] ; then
    APPIMAGE_ARGV0=$0
fi

APPIMAGE_COMMAND=$(basename "$APPIMAGE_ARGV0")

if [ ! -f "$APPIMAGE_BINARY_DIR/$APPIMAGE_COMMAND" ] || [ ! -x "$APPIMAGE_BINARY_DIR/$APPIMAGE_COMMAND" ] ; then
    APPIMAGE_COMMAND="${APPIMAGE_BINARY_NAME}"
fi

exec "$APPIMAGE_BINARY_DIR/$APPIMAGE_COMMAND" "$@"
