{
  "id": "${FLATPAK_APP_ID}",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "${FLATPAK_COMMAND}",
  "modules": [
    {
      "name": "libsigc++",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsigc++/2.12/libsigc++-2.12.1.tar.xz",
          "sha256": "a9dbee323351d109b7aee074a9cb89ca3e7bcf8ad8edef1851f4cf359bd50843"
        }
      ]
    },
    {
      "name": "glibmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/glibmm/2.66/glibmm-2.66.10.tar.xz",
          "sha256": "2b61780203aed98e701d3ea57c8f353e7c8ada9706a79be782f6c5153dd035c0"
        }
      ]
    },
    {
      "name": "cairomm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.cairographics.org/releases/cairomm-1.14.6.tar.xz",
          "mirror-urls": [
            "https://src.fedoraproject.org/repo/pkgs/cairomm/cairomm-1.14.6.tar.xz/sha512/5d7c988613b6e6694ed8e1396ac9967df375f545d0060cd6c584e397ba7c03ed0f55261b00bb4c3773d1d8d4401862f2658d3698061a20757c11ea525802e4d1/cairomm-1.14.6.tar.xz"
          ],
          "sha256": "7e0d5c7f29175d573a03ab5c45aef63f48dd91a5caf335a404cd763e4b7cea4a"
        }
      ]
    },
    {
      "name": "pangomm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/pangomm/2.46/pangomm-2.46.5.tar.xz",
          "sha256": "38ca0b050b065de4e3da0c182df657437757063bbf0c4b6c9567ddba019b1d68"
        }
      ]
    },
    {
      "name": "atkmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/atkmm/2.28/atkmm-2.28.5.tar.xz",
          "sha256": "ae449192a582a2582a95e0602b15d792bbd639e836339b81ef916aa87540ac5c"
        }
      ]
    },
    {
      "name": "gtkmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-demos=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.11.tar.xz",
          "sha256": "19e383c82d5dd89db275e00b82864e90414d4c3fb3d100b2f996bcc2338a4cc7"
        }
      ]
    },
    {
      "name": "nlohmann-json",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DJSON_BuildTests=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/nlohmann/json.git",
          "tag": "v3.11.3"
        }
      ]
    },
    {
      "name": "opencv",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_LIST=core,imgproc,imgcodecs",
        "-DBUILD_TESTS=OFF",
        "-DBUILD_PERF_TESTS=OFF",
        "-DBUILD_EXAMPLES=OFF",
        "-DBUILD_opencv_apps=OFF",
        "-DBUILD_JAVA=OFF",
        "-DBUILD_opencv_python3=OFF",
        "-DWITH_IPP=OFF",
        "-DWITH_ADE=OFF",
        "-DWITH_ITT=OFF",
        "-DWITH_FFMPEG=OFF",
        "-DWITH_GSTREAMER=OFF",
        "-DWITH_GTK=OFF",
        "-DWITH_QT=OFF",
        "-DWITH_V4L=OFF",
        "-DWITH_OPENCL=OFF",
        "-DWITH_PROTOBUF=OFF",
        "-DWITH_EIGEN=OFF",
        "-DOPENCV_GENERATE_PKGCONFIG=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/opencv/opencv/archive/refs/tags/4.10.0.tar.gz",
          "sha256": "b2171af5be6b26f7a06b1229948bbb2bdaa74fcf5cd097e0af6378fce50a6eb9"
        }
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/cmake",
        "/share/opencv4"
      ]
    },
    {
      "name": "ImagesAnnotator-DataDrivers",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "${TEMPLATE_APP_IADD_GIT}",
          "branch": "${TEMPLATE_APP_IADD_GIT_TAG}"
        }
      ]
    },
    {
      "name": "ImagesAnnotator-DataExporters",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "${TEMPLATE_APP_IADE_GIT}",
          "branch": "${TEMPLATE_APP_IADE_GIT_TAG}"
        }
      ]
    },
    {
      "name": "ImagesAnnotator-DataImporters",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "${TEMPLATE_APP_IADI_GIT}",
          "branch": "${TEMPLATE_APP_IADI_GIT_TAG}"
        }
      ]
    },
    {
      "name": "${PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DUSE_GTKMM3=ON",
        "-DENABLE_IMAGES_ANNOTATOR_CONVERTER=${ENABLE_IMAGES_ANNOTATOR_CONVERTER}"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ],
  "finish-args": [
    "--filesystem=/run/host",
    "--share=ipc", 
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.DBus",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=${FLATPAK_APP_ID}"
  ]
}
